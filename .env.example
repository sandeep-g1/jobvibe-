# Copy to .env and fill in. .env is gitignored — your password never leaves your machine.

# Supabase: Project Settings > Database > Connection string > Transaction pooler
# Use port 6543 (pooler), NOT 5432 (direct) — the free tier does not serve
# direct connections over IPv4, and serverless needs pooling anyway.
DATABASE_URL=postgresql://postgres.tojkqxoczfpqurkpftas:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Required before hosting publicly — without it the dashboard is open to anyone.
APP_PASSWORD=

# Leave unset locally; Vercel sets it automatically.
# PORT=3100
