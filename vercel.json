{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [{ "path": "/api/cron", "schedule": "30 2 * * *" }],
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{profile.example.json,profile.local.json,profile.json,data/**}"
    }
  }
}
